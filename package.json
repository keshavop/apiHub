{
  "name": "apihub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "sample:repo": "tsx scripts/sample-repo.ts",
    "sync": "tsx --conditions=react-server scripts/sync.ts",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:reset": "rm -f prisma/dev.db && prisma migrate deploy && pnpm db:seed",
    "check:semver": "tsx --conditions=react-server scripts/check-semver.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@node-rs/argon2": "^2.2.2",
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/api-reference-react": "^0.9.88",
    "@stoplight/spectral-core": "^1.24.0",
    "@stoplight/spectral-functions": "^1.11.0",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@stoplight/spectral-ref-resolver": "^1.0.5",
    "@stoplight/spectral-rulesets": "^1.23.0",
    "better-sqlite3": "12.11.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "openapi-sampler": "^1.7.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "^7.8.6",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.8.0",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.2"
}
