# --- Database -------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"

# --- Spec source ----------------------------------------------------------
# "local-git": a git repo on disk (good for dev; `pnpm sample:repo` creates one)
# "github":    a GitHub repository read through the REST API
SPEC_SOURCE="local-git"
SPEC_REPO_PATH="./.data/spec-repo"
SPEC_DEFAULT_BRANCH="main"

# For SPEC_SOURCE=github
GITHUB_REPO=""            # owner/name, e.g. your-org/api-specs
GITHUB_TOKEN=""           # fine-grained token: contents r/w, pull requests r/w, commit statuses r/w
GITHUB_WEBHOOK_SECRET=""  # same secret as the repo webhook (push, pull_request, create)

# --- Staff sign-in (GitHub OAuth app) -------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# GitHub logins that become owners on first sign-in (comma separated).
BOOTSTRAP_OWNER_LOGINS=""

# Local only: shows "Dev sign-in as owner" on /login. Ignored in production.
ALLOW_DEV_LOGIN="true"

# --- Email (partner set-password / reset links) ---------------------------
# Without a key, links are printed to the server log instead of emailed.
RESEND_API_KEY=""
EMAIL_FROM="apiHub <no-reply@example.com>"
